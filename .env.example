# Copia este archivo a .env y rellena los valores antes de levantar docker compose.

# Secreto para firmar los JWT de sesión de BiblioBot. Genera uno con: openssl rand -hex 32
JWT_SECRET=

# Clave usada para cifrar (AES-256-GCM) las credenciales de PatronBase guardadas en BD.
# Genera una con: openssl rand -hex 32
CREDENTIALS_ENC_KEY=

# Ruta del fichero SQLite dentro del contenedor backend (no cambiar salvo que sepas lo que haces).
DATABASE_URL=file:/data/bibliobot.db

# Base de la instancia PatronBase de la Red de Bibliotecas Públicas de Ceuta.
PATRONBASE_BASE_URL=https://es.patronbase.com/_BibliotecaCeuta

# Minutos de espera antes de reintentar una reserva programada fallida.
SCHEDULE_RETRY_DELAY_MINUTES=1
